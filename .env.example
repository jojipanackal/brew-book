# For a PostgreSQL container on the same Docker network, use the service name
# and omit sslmode. Add ?sslmode=require for a hosted TLS-only database.
DATABASE_URL=
DATABASE_CA_CERT=
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SENTRY_DSN=
SENTRY_ENVIRONMENT=
VITE_SENTRY_DSN=

